# NetEase Cloud Music Cookie
# Recommended: paste the WHOLE Cookie header (F12 -> Network -> any music.163.com
# request -> Request Headers -> Cookie). It must contain MUSIC_U and __csrf.
# A MUSIC_U-only cookie may be rejected by playlist create/update with
# "403 illegal request".
NETEASE_COOKIE=MUSIC_U=your_music_u_here; __csrf=your_csrf_here

# Optional: set the csrf separately (it is added to the Cookie header automatically)
# NETEASE_CSRF=

# Optional: logged-in user id (looked up automatically when empty)
# NETEASE_UID=

# Optional: timezone of timestamps in tool output, in hours (Beijing = 8, UTC = 0)
# NETEASE_TZ_OFFSET=8

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=3456
# Optional: comma-separated browser origins allowed to call /mcp (default: localhost only)
# MCP_ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: AI analysis for the web console's listening profile
# ---------------------------------------------------------------------------
# The browser posts the statistics it already computed to POST /analyze and the
# server calls the model. The key stays server-side and is never sent to the page.
# Leave DEEPSEEK_API_KEY empty to keep the local rule-based wording (default);
# the project then still runs end to end without any third-party credentials.
#
# Get a key at https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat          # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=45                   # seconds
# DEEPSEEK_MAX_TOKENS=800

# Logging: DEBUG / INFO / WARNING / QUIET
# LOG_LEVEL=INFO
