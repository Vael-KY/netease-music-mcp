# NetEase Cloud Music Cookie
# Recommended: paste the WHOLE Cookie header (F12 -> Network -> any music.163.com request
# -> Request Headers -> Cookie). It must contain MUSIC_U and __csrf. A MUSIC_U-only cookie
# may be rejected by playlist create/update with "403 illegal request".
NETEASE_COOKIE=MUSIC_U=your_music_u_here; __csrf=your_csrf_here

# Optional: set the csrf separately (it is added to the Cookie header automatically)
# NETEASE_CSRF=

# Optional: timezone of timestamps in tool output, in hours (Beijing = 8). Default: UTC
# NETEASE_TZ_OFFSET=8

# MCP Server Port
MCP_PORT=3456

# Optional: require `Authorization: Bearer <token>` on every MCP request (recommended on a public server)
# MCP_AUTH_TOKEN=
# Optional: listen address (127.0.0.1 = this machine only). Default 0.0.0.0
# MCP_HOST=0.0.0.0
# Optional: browser origins allowed to call the server, comma-separated (localhost is always allowed)
# MCP_ALLOWED_ORIGINS=

# --- Listen Together extension (optional, see server/mcp-server/together/README.md) ---
# TOGETHER_ENABLED=true
# The AI's own NetEase account for Listen Together (NETEASE_COOKIE stays yours for the normal tools)
# TOGETHER_COOKIE=MUSIC_U=...; __csrf=...
# Only needed if invitations should come from someone other than NETEASE_COOKIE's account
# TOGETHER_INVITER_UID=your_netease_user_id
# Optional: bridge room events into your own chat frontend's relay (see together/README.md):
# COMPANION_RELAY_URL=
# COMPANION_RELAY_SECRET=
# COMPANION_SESSION=
# With the bridge on, no together_* MCP tools are listed by default; 'control' keeps playback control
# TOGETHER_MCP_TOOLS=
